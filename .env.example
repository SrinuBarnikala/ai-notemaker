# Environment
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000

# Database
DATABASE_URL=sqlite:///./data/app.db

# LLM Provider Configuration
# Supported providers: ollama, groq, openai, mock
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:7b

# Ollama settings
OLLAMA_BASE_URL=http://localhost:11434

# Groq / OpenAI settings (for future phases)
GROQ_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
